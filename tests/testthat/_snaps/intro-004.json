      "html": "<h1>Demographic Information<\/h1>\n<div id=\"educ\" class=\"form-group shiny-input-radiogroup shiny-input-container\" role=\"radiogroup\" aria-labelledby=\"educ-label\">\n  <label class=\"control-label\" id=\"educ-label\" for=\"educ\">Please specify your education:<\/label>\n  <div class=\"shiny-options-group\">\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"educ\" value=\"Less than high school\"/>\n        <span>Less than high school<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"educ\" value=\"High school graduate\"/>\n        <span>High school graduate<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"educ\" value=\"Some college\"/>\n        <span>Some college<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"educ\" value=\"2 year degree\"/>\n        <span>2 year degree<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"educ\" value=\"4 year degree\"/>\n        <span>4 year degree<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"educ\" value=\"Professional degree\"/>\n        <span>Professional degree<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"educ\" value=\"Doctorate\"/>\n        <span>Doctorate<\/span>\n      <\/label>\n    <\/div>\n  <\/div>\n<\/div>\n<br/>\n<div id=\"vote\" class=\"form-group shiny-input-radiogroup shiny-input-container\" role=\"radiogroup\" aria-labelledby=\"vote-label\">\n  <label class=\"control-label\" id=\"vote-label\" for=\"vote\">I tend to vote:<\/label>\n  <div class=\"shiny-options-group\">\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"vote\" value=\"Republican\"/>\n        <span>Republican<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"vote\" value=\"Democratic\"/>\n        <span>Democratic<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"vote\" value=\"No consistent preference\"/>\n        <span>No consistent preference<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"vote\" value=\"Other\"/>\n        <span>Other<\/span>\n      <\/label>\n    <\/div>\n  <\/div>\n<\/div>\n<br/>\n<div id=\"poli\" class=\"form-group shiny-input-radiogroup shiny-input-container\" role=\"radiogroup\" aria-labelledby=\"poli-label\">\n  <label class=\"control-label\" id=\"poli-label\" for=\"poli\">My political views tend to be:<\/label>\n  <div class=\"shiny-options-group\">\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"poli\" value=\"Very Liberal\"/>\n        <span>Very Liberal<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"poli\" value=\"Somewhat Liberal\"/>\n        <span>Somewhat Liberal<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"poli\" value=\"Middle of the Road\"/>\n        <span>Middle of the Road<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"poli\" value=\"Somewhat Conservative\"/>\n        <span>Somewhat Conservative<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"poli\" value=\"Very Conservative\"/>\n        <span>Very Conservative<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"poli\" value=\"Other\"/>\n        <span>Other<\/span>\n      <\/label>\n    <\/div>\n  <\/div>\n<\/div>\n<br/>\n<div id=\"arrest\" class=\"form-group shiny-input-radiogroup shiny-input-container\" role=\"radiogroup\" aria-labelledby=\"arrest-label\">\n  <label class=\"control-label\" id=\"arrest-label\" for=\"arrest\">Have you or a member of your immediate family ever been arrested by the police?<\/label>\n  <div class=\"shiny-options-group\">\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"arrest\" value=\"Yes\"/>\n        <span>Yes<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"arrest\" value=\"No\"/>\n        <span>No<\/span>\n      <\/label>\n    <\/div>\n  <\/div>\n<\/div>\n<br/>\n<div class=\"form-group shiny-input-container\" style=\"width:300px;\">\n  <label class=\"control-label\" id=\"state-label\" for=\"state\">In which state/territory do you currently reside?<\/label>\n  <div>\n    <select id=\"state\" class=\"shiny-input-select\"><option value=\"\" selected><\/option>\n<option value=\"AL\">AL<\/option>\n<option value=\"AK\">AK<\/option>\n<option value=\"AZ\">AZ<\/option>\n<option value=\"AR\">AR<\/option>\n<option value=\"AS\">AS<\/option>\n<option value=\"CA\">CA<\/option>\n<option value=\"CM\">CM<\/option>\n<option value=\"CO\">CO<\/option>\n<option value=\"CT\">CT<\/option>\n<option value=\"DE\">DE<\/option>\n<option value=\"DC\">DC<\/option>\n<option value=\"FL\">FL<\/option>\n<option value=\"GA\">GA<\/option>\n<option value=\"GU\">GU<\/option>\n<option value=\"HI\">HI<\/option>\n<option value=\"ID\">ID<\/option>\n<option value=\"IL\">IL<\/option>\n<option value=\"IN\">IN<\/option>\n<option value=\"IA\">IA<\/option>\n<option value=\"KS\">KS<\/option>\n<option value=\"KY\">KY<\/option>\n<option value=\"LA\">LA<\/option>\n<option value=\"ME\">ME<\/option>\n<option value=\"MD\">MD<\/option>\n<option value=\"MA\">MA<\/option>\n<option value=\"MI\">MI<\/option>\n<option value=\"MN\">MN<\/option>\n<option value=\"MO\">MO<\/option>\n<option value=\"MS\">MS<\/option>\n<option value=\"MT\">MT<\/option>\n<option value=\"NE\">NE<\/option>\n<option value=\"NV\">NV<\/option>\n<option value=\"NH\">NH<\/option>\n<option value=\"NJ\">NJ<\/option>\n<option value=\"NM\">NM<\/option>\n<option value=\"NY\">NY<\/option>\n<option value=\"NC\">NC<\/option>\n<option value=\"ND\">ND<\/option>\n<option value=\"OH\">OH<\/option>\n<option value=\"OK\">OK<\/option>\n<option value=\"OR\">OR<\/option>\n<option value=\"PA\">PA<\/option>\n<option value=\"PR\">PR<\/option>\n<option value=\"RI\">RI<\/option>\n<option value=\"SC\">SC<\/option>\n<option value=\"SD\">SD<\/option>\n<option value=\"TN\">TN<\/option>\n<option value=\"TT\">TT<\/option>\n<option value=\"TX\">TX<\/option>\n<option value=\"UT\">UT<\/option>\n<option value=\"VA\">VA<\/option>\n<option value=\"VT\">VT<\/option>\n<option value=\"VI\">VI<\/option>\n<option value=\"WA\">WA<\/option>\n<option value=\"WV\">WV<\/option>\n<option value=\"WI\">WI<\/option>\n<option value=\"WY\">WY<\/option><\/select>\n    <script type=\"application/json\" data-for=\"state\">{\"plugins\":[\"selectize-plugin-a11y\"]}<\/script>\n  <\/div>\n<\/div>\n<br/>\n<div id=\"jury\" class=\"form-group shiny-input-radiogroup shiny-input-container\" role=\"radiogroup\" aria-labelledby=\"jury-label\">\n  <label class=\"control-label\" id=\"jury-label\" for=\"jury\">Have you ever served on a jury before?<\/label>\n  <div class=\"shiny-options-group\">\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"jury\" value=\"Yes\"/>\n        <span>Yes<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"jury\" value=\"No\"/>\n        <span>No<\/span>\n      <\/label>\n    <\/div>\n  <\/div>\n<\/div>\n<br/>\n<div id=\"jurycrim\" class=\"form-group shiny-input-radiogroup shiny-input-container\" role=\"radiogroup\" aria-labelledby=\"jurycrim-label\">\n  <label class=\"control-label\" id=\"jurycrim-label\" for=\"jurycrim\">If you have served on a jury, did the trial involve criminal charges against the defendant?<\/label>\n  <div class=\"shiny-options-group\">\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"jurycrim\" value=\"Yes\"/>\n        <span>Yes<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"jurycrim\" value=\"No\"/>\n        <span>No<\/span>\n      <\/label>\n    <\/div>\n    <div class=\"radio\">\n      <label>\n        <input type=\"radio\" name=\"jurycrim\" value=\"N/A\" checked=\"checked\"/>\n        <span>N/A<\/span>\n      <\/label>\n    <\/div>\n  <\/div>\n<\/div>\n<br/>",
